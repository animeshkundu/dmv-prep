---
import BaseLayout from '../layouts/BaseLayout.astro';
import { href } from '../lib/site';
import '../styles/pages.css';
---

<BaseLayout title="Page Not Found" description="The requested DMV Prep page could not be found." noindex>
  <section class="container notfound">
    <div class="notfound-inner">
      <p class="code">404</p>
      <p class="eyebrow">Wrong turn</p>
      <h1>This road does not go anywhere.</h1>
      <p class="lede">Head back to the state directory and we will get your permit prep moving again.</p>
      <div class="actions">
        <a class="btn btn-primary" href={href('/')}>Go home</a>
        <a class="btn btn-ghost" href={href('/states')}>Choose your state</a>
      </div>
    </div>
  </section>
</BaseLayout>
