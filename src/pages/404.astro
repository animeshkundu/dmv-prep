---
import BaseLayout from '../layouts/BaseLayout.astro';
import { href } from '../lib/site';
---

<BaseLayout title="Page not found">
  <section class="container notfound">
    <p class="code">404</p>
    <h1>We took a wrong turn.</h1>
    <p class="lede">That page doesn't exist. Let's get you back on the road.</p>
    <div class="actions">
      <a class="btn btn-primary" href={href('/')}>Go home</a>
      <a class="btn btn-ghost" href={href('/states')}>Pick your state</a>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound {
    text-align: center;
    padding-block: var(--sp-10);
  }
  .code {
    font-size: var(--fs-3xl);
    font-weight: 800;
    color: var(--c-accent);
  }
  .lede {
    color: var(--c-text-muted);
    margin-top: var(--sp-3);
  }
  .actions {
    margin-top: var(--sp-6);
    display: flex;
    gap: var(--sp-3);
    justify-content: center;
    flex-wrap: wrap;
  }
</style>
