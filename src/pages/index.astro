---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { STATES, stateSlug } from '../lib/states-directory';
import { href } from '../lib/site';

const questionCount = (await getCollection('questions')).length;
const features = [
  {
    number: '01',
    title: 'Practice that teaches',
    description: 'Every answer unlocks a clear explanation and a direct source citation, so you learn the rule instead of memorizing a guess.',
    link: '/states',
    action: 'Start state practice',
  },
  {
    number: '02',
    title: 'A real exam rehearsal',
    description: 'Match your state’s question count and passing score. Answers stay hidden until the end, just like test day.',
    link: '/states',
    action: 'Find your mock exam',
  },
  {
    number: '03',
    title: 'Memory that sticks',
    description: 'Smart flashcards schedule the right review at the right time, with no streak pressure and no account required.',
    link: '/progress',
    action: 'See how progress works',
  },
  {
    number: '04',
    title: 'Signs at a glance',
    description: 'Train fast road-sign recognition with visual drills, then keep the complete reference nearby.',
    link: '/signs',
    action: 'Train road signs',
  },
];
const faqs = [
  {
    question: 'Is DMV Prep really free?',
    answer: 'Yes. Practice tests, mock exams, flashcards, road-sign training, progress tracking, and permit guides are all free. There is no account or paid tier.',
  },
  {
    question: 'Are these the real DMV test questions?',
    answer: 'No. Real exam questions are not published. Our questions are original and grounded in public state handbooks, with a citation shown after each answer.',
  },
  {
    question: 'Does DMV Prep work for my state?',
    answer: 'DMV Prep covers all 50 states and Washington, DC. State pages include available exam details, practice, mock exams, flashcards, and permit-process guidance.',
  },
  {
    question: 'Where is my progress stored?',
    answer: 'Your progress stays in your browser on your device. You can export a backup from the progress page, and you can study without creating an account.',
  },
];
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---

<BaseLayout
  title="Free DMV Permit Practice Tests for Every State"
  description="Pass your learner's permit test with free state-specific practice, realistic mock exams, smart flashcards, road signs, and cited permit guides."
  structuredData={faqSchema}
>
  <section class="home-hero">
    <div class="container container-wide hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Free DMV prep for every state</p>
        <h1>Know the road.<br /><span>Own the test.</span></h1>
        <p class="hero-lede">
          The focused, no-paywall way to prepare for your permit test. Learn the rules, rehearse
          the real format, and walk in ready.
        </p>
        <div class="hero-actions">
          <a class="btn btn-pop" href="#choose-state">Choose your state <span aria-hidden="true">→</span></a>
          <a class="btn btn-ghost" href={href('/signs')}>Practice road signs</a>
        </div>
        <ul class="hero-proof" aria-label="DMV Prep benefits">
          <li><span aria-hidden="true">✓</span> No signup</li>
          <li><span aria-hidden="true">✓</span> No ads</li>
          <li><span aria-hidden="true">✓</span> Works offline</li>
          <li><span aria-hidden="true">✓</span> Cited answers</li>
        </ul>
      </div>

      <div id="choose-state" class="state-picker card" role="search">
        <div class="picker-heading">
          <span class="picker-step">Start here</span>
          <h2>Where will you test?</h2>
          <p>Pick your state for the right rules, score, and permit steps.</p>
        </div>
        <label for="state-search">Search your state</label>
        <div class="search-wrap">
          <span aria-hidden="true">⌕</span>
          <input
            id="state-search"
            type="search"
            placeholder="Search your state…"
            autocomplete="off"
            aria-controls="state-list"
          />
        </div>
        <ul id="state-list" class="state-list" aria-label="US states and Washington, DC">
          {
            STATES.map((state) => (
              <li data-name={`${state.name} ${state.code}`.toLowerCase()}>
                <a href={href(`/state/${stateSlug(state.code)}`)}>
                  <span class="state-abbr">{state.code}</span>
                  <span>{state.name}</span>
                  <span class="state-arrow" aria-hidden="true">→</span>
                </a>
              </li>
            ))
          }
        </ul>
        <p id="no-match" class="empty-search" hidden>No state matches that search.</p>
      </div>
    </div>
  </section>

  <section class="proof-section" aria-label="Coverage and product facts">
    <div class="container trust-band">
      <div><strong>50 + DC</strong><span>Every US jurisdiction</span></div>
      <div><strong>{questionCount}</strong><span>Original cited questions</span></div>
      <div><strong>$0</strong><span>Every feature, always</span></div>
      <div><strong>On device</strong><span>Your private progress</span></div>
    </div>
  </section>

  <section class="home-section">
    <div class="container">
      <div class="section-heading center">
        <p class="eyebrow">A clear road to ready</p>
        <h2>Study smarter, not longer.</h2>
        <p class="lede">
          A connected prep system takes you from first question to confident test day.
        </p>
      </div>
      <ol class="journey">
        <li>
          <span class="journey-number">1</span>
          <div><h3>Learn</h3><p>Build the rules topic by topic with immediate, cited feedback.</p></div>
        </li>
        <li>
          <span class="journey-number">2</span>
          <div><h3>Rehearse</h3><p>Switch to your state’s mock format when practice feels familiar.</p></div>
        </li>
        <li>
          <span class="journey-number">3</span>
          <div><h3>Pass</h3><p>Review weak areas, know what to bring, and arrive without surprises.</p></div>
        </li>
      </ol>
    </div>
  </section>

  <section class="home-section feature-section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">One complete toolkit</p>
        <h2>Everything between “I should study” and “I passed.”</h2>
      </div>
      <div class="feature-bento">
        {
          features.map((feature) => (
            <article class="feature-card card">
              <span class="feature-number">{feature.number}</span>
              <h3>{feature.title}</h3>
              <p>{feature.description}</p>
              <a href={href(feature.link)}>{feature.action} <span aria-hidden="true">→</span></a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="home-section">
    <div class="container trust-story card card-strong">
      <div>
        <p class="eyebrow">Trust without the sales pitch</p>
        <h2>Built to help you pass, not to upsell you.</h2>
      </div>
      <div class="trust-points">
        <article><strong>Source-first</strong><p>Questions link learning back to handbook sections and public rules.</p></article>
        <article><strong>Private by default</strong><p>No profile. Your study history stays on your device.</p></article>
        <article><strong>Useful offline</strong><p>Install the app and keep studying when your connection drops.</p></article>
        <article><strong>Accessible</strong><p>Keyboard-ready controls, clear focus, and more than color for feedback.</p></article>
      </div>
    </div>
  </section>

  <section class="home-section">
    <div class="container faq-layout">
      <div class="section-heading">
        <p class="eyebrow">Good to know</p>
        <h2>Straight answers before you start.</h2>
      </div>
      <div class="faq-list">
        {
          faqs.map((item, index) => (
            <details open={index === 0}>
              <summary>{item.question}<span aria-hidden="true">+</span></summary>
              <p>{item.answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const input = document.getElementById('state-search') as HTMLInputElement | null;
  const list = document.getElementById('state-list');
  const noMatch = document.getElementById('no-match');
  input?.addEventListener('input', () => {
    const query = input.value.trim().toLowerCase();
    let visible = 0;
    list?.querySelectorAll<HTMLLIElement>('li').forEach((item) => {
      const matches = !query || (item.dataset.name ?? '').includes(query);
      item.hidden = !matches;
      if (matches) visible += 1;
    });
    if (noMatch) noMatch.hidden = visible !== 0;
  });
</script>

<style>
  .home-hero {
    position: relative;
    padding-block: var(--sp-8) var(--sp-10);
  }

  .home-hero::before {
    position: absolute;
    top: var(--sp-8);
    left: 0;
    width: 42%;
    height: 70%;
    content: '';
    background:
      repeating-linear-gradient(
        130deg,
        transparent 0 var(--sp-5),
        color-mix(in srgb, var(--c-accent) 8%, transparent) var(--sp-5) var(--sp-6)
      );
    border-radius: 0 var(--r-xl) var(--r-xl) 0;
    pointer-events: none;
  }

  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(22rem, 0.8fr);
    gap: var(--sp-8);
    align-items: center;
  }

  .hero-copy {
    display: grid;
    gap: var(--sp-5);
    padding-block: var(--sp-8);
  }

  .hero-copy h1 {
    max-width: 54rem;
    font-size: var(--fs-4xl);
    letter-spacing: -0.065em;
  }

  .hero-copy h1 span {
    color: var(--c-accent);
  }

  .hero-lede {
    max-width: 42rem;
    color: var(--c-text-muted);
    font-size: var(--fs-xl);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
  }

  .hero-proof {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3) var(--sp-5);
    padding: 0;
    list-style: none;
    color: var(--c-text-muted);
    font-size: var(--fs-sm);
    font-weight: 700;
  }

  .hero-proof span {
    color: var(--c-pass);
  }

  .state-picker {
    display: grid;
    gap: var(--sp-4);
    padding: var(--sp-6);
    box-shadow: var(--shadow-lg);
  }

  .picker-heading {
    display: grid;
    gap: var(--sp-2);
  }

  .picker-heading p {
    color: var(--c-text-muted);
  }

  .picker-step {
    width: fit-content;
    padding: var(--sp-1) var(--sp-3);
    color: var(--c-pop);
    background: var(--c-pop-soft);
    border-radius: var(--r-full);
    font-size: var(--fs-xs);
    font-weight: 850;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .state-picker > label {
    font-size: var(--fs-sm);
    font-weight: 850;
  }

  .search-wrap {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    border: var(--border-width-strong) solid var(--c-border);
    border-radius: var(--r-md);
  }

  .search-wrap:focus-within {
    border-color: var(--c-accent);
    box-shadow: var(--focus-ring);
  }

  .search-wrap > span {
    padding-left: var(--sp-4);
    color: var(--c-text-faint);
    font-size: var(--fs-xl);
  }

  #state-search {
    width: 100%;
    min-height: var(--control);
    padding: var(--sp-3);
    color: var(--c-text);
    background: transparent;
    border: 0;
    outline: 0;
  }

  .state-list {
    display: grid;
    gap: var(--sp-1);
    max-height: 22rem;
    padding: var(--sp-1);
    overflow-y: auto;
    list-style: none;
    scrollbar-color: var(--c-border-strong) transparent;
  }

  .state-list a {
    display: grid;
    grid-template-columns: var(--control) 1fr auto;
    gap: var(--sp-3);
    align-items: center;
    min-height: var(--control);
    padding: var(--sp-2);
    color: var(--c-text);
    border-radius: var(--r-md);
    font-weight: 750;
    text-decoration: none;
  }

  .state-list a:hover {
    color: var(--c-accent-strong);
    background: var(--c-accent-soft);
  }

  .state-abbr {
    display: grid;
    place-items: center;
    height: var(--control);
    color: var(--c-accent-strong);
    background: var(--c-accent-soft);
    border-radius: var(--r-sm);
    font-size: var(--fs-xs);
    font-weight: 900;
  }

  .state-arrow {
    color: var(--c-accent);
  }

  .proof-section {
    padding-bottom: var(--sp-10);
  }

  .home-section {
    padding-block: var(--sp-10);
  }

  .journey {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--sp-5);
    padding: 0;
    list-style: none;
  }

  .journey::before {
    position: absolute;
    top: calc(var(--control) / 2);
    right: 15%;
    left: 15%;
    height: var(--border-width-strong);
    content: '';
    background: var(--c-border);
  }

  .journey li {
    position: relative;
    display: grid;
    gap: var(--sp-4);
    justify-items: center;
    padding: var(--sp-4);
    text-align: center;
  }

  .journey-number {
    display: grid;
    place-items: center;
    width: var(--control);
    height: var(--control);
    color: var(--c-accent-contrast);
    background: var(--c-accent);
    border: var(--sp-2) solid var(--c-bg);
    border-radius: var(--r-full);
    font-weight: 900;
    box-sizing: content-box;
  }

  .journey p {
    margin-top: var(--sp-2);
    color: var(--c-text-muted);
  }

  .feature-section {
    background: color-mix(in srgb, var(--c-surface-2) 62%, transparent);
  }

  .feature-bento {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--sp-4);
  }

  .feature-card {
    position: relative;
    display: grid;
    gap: var(--sp-4);
    min-height: 20rem;
    padding: var(--sp-7);
    overflow: hidden;
  }

  .feature-card:nth-child(1),
  .feature-card:nth-child(4) {
    background:
      linear-gradient(145deg, var(--c-surface), var(--c-accent-soft));
  }

  .feature-card h3 {
    max-width: 25rem;
    font-size: var(--fs-2xl);
  }

  .feature-card p {
    max-width: 36rem;
    color: var(--c-text-muted);
  }

  .feature-card a {
    align-self: end;
    width: fit-content;
    font-weight: 850;
  }

  .feature-number {
    color: var(--c-pop);
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    font-weight: 800;
  }

  .trust-story {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: var(--sp-8);
    padding: var(--sp-8);
    border-radius: var(--r-xl);
    box-shadow: var(--shadow-lg);
  }

  .trust-story h2 {
    margin-top: var(--sp-4);
  }

  .trust-points {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-5);
  }

  .trust-points article {
    padding-top: var(--sp-3);
    border-top: var(--border-width) solid color-mix(in srgb, var(--c-on-strong) 25%, transparent);
  }

  .trust-points strong {
    font-size: var(--fs-lg);
  }

  .trust-points p {
    margin-top: var(--sp-2);
    color: var(--c-on-strong-muted);
    font-size: var(--fs-sm);
  }

  .faq-layout {
    display: grid;
    grid-template-columns: minmax(16rem, 0.65fr) minmax(0, 1.35fr);
    gap: var(--sp-8);
    align-items: start;
  }

  .faq-list {
    display: grid;
    border-top: var(--border-width) solid var(--c-border);
  }

  .faq-list details {
    padding: var(--sp-5) 0;
    border-bottom: var(--border-width) solid var(--c-border);
  }

  .faq-list summary {
    display: flex;
    gap: var(--sp-4);
    justify-content: space-between;
    color: var(--c-text);
    font-size: var(--fs-lg);
    font-weight: 850;
    list-style: none;
    cursor: pointer;
  }

  .faq-list summary::-webkit-details-marker {
    display: none;
  }

  .faq-list summary span {
    color: var(--c-accent);
    font-size: var(--fs-xl);
  }

  .faq-list details[open] summary span {
    transform: rotate(45deg);
  }

  .faq-list p {
    max-width: 45rem;
    margin-top: var(--sp-3);
    color: var(--c-text-muted);
  }

  @media (max-width: 58rem) {
    .hero-grid,
    .trust-story,
    .faq-layout {
      grid-template-columns: 1fr;
    }

    .home-hero::before {
      width: 75%;
    }

    .state-picker {
      max-width: 42rem;
    }
  }

  @media (max-width: 42rem) {
    .home-hero {
      padding-block: var(--sp-4) var(--sp-8);
    }

    .hero-grid {
      gap: var(--sp-4);
    }

    .hero-copy {
      padding-block: var(--sp-5);
    }

    .state-picker {
      padding: var(--sp-5);
    }

    .journey,
    .feature-bento,
    .trust-points {
      grid-template-columns: 1fr;
    }

    .journey::before {
      display: none;
    }

    .journey li {
      grid-template-columns: var(--control) 1fr;
      justify-items: start;
      text-align: left;
    }

    .feature-card {
      min-height: 17rem;
      padding: var(--sp-5);
    }

    .trust-story {
      padding: var(--sp-6) var(--sp-5);
      border-radius: var(--r-lg);
    }
  }
</style>
