---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { STATES, byCode, stateSlug } from '../../../lib/states-directory';
import { studyContent } from '../../../lib/content';
import { href } from '../../../lib/site';
import '../../../styles/pages.css';

export function getStaticPaths() {
  return STATES.map((state) => ({ params: { code: stateSlug(state.code) } }));
}

const code = Astro.params.code!.toUpperCase();
const directory = byCode(code)!;
const { state } = await studyContent(code);
const description = `How to get a ${directory.name} learner's permit: current age rules, documents, appointments, fees, vision requirements, and official links.`;
const howToSchema = state ? {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: `How to get a ${directory.name} learner's permit`,
  description,
  step: [
    { '@type': 'HowToStep', name: 'Check eligibility', text: `The listed minimum permit age is ${state.gdl.permitMinAge}.` },
    { '@type': 'HowToStep', name: 'Gather documents', text: state.process.requiredDocuments.join(', ') },
    { '@type': 'HowToStep', name: 'Prepare for testing', text: 'Study the official handbook and complete permit-test practice.' },
    { '@type': 'HowToStep', name: 'Apply with the licensing agency', text: `Confirm appointments and fees with ${state.agencyName}.` },
  ],
} : undefined;
---

<BaseLayout
  title={`How to Get a ${directory.name} Learner's Permit`}
  description={description}
  structuredData={howToSchema ?? []}
>
  <section class="container page-shell">
    <Breadcrumbs
      items={[
        { label: 'Home', path: '/' },
        { label: 'States', path: '/states' },
        { label: directory.name, path: `/state/${stateSlug(code)}` },
        { label: 'Permit guide' },
      ]}
    />
    <header class="page-hero">
      <p class="eyebrow">{directory.name} permit guide</p>
      <h1>From paperwork to permit, one clear path.</h1>
      <p class="lede">
        Use this checklist to plan your application, then confirm final details with
        {' '}{state?.agencyShort ?? directory.agencyShort} before you go.
      </p>
      {state && <span class="badge">Details verified {state.lastVerified}</span>}
    </header>

    {state ? (
      <>
        <section class="metric-grid" aria-label="Permit facts">
          <article class="metric card"><strong>{state.gdl.permitMinAge}</strong><span>minimum permit age</span></article>
          <article class="metric card"><strong>{state.process.appointmentRequired}</strong><span>appointment status</span></article>
          <article class="metric card"><strong>{state.process.permitFee ? 'Fee listed' : 'Check fee'}</strong><span>see current detail below</span></article>
          <article class="metric card"><strong>{state.process.visionTestRequired ? 'Required' : 'Not listed'}</strong><span>vision screening</span></article>
        </section>

        <section class="content-split">
          <div class="stack">
            <article class="card article-card">
              <p class="eyebrow">Step 1</p>
              <h2>Check your eligibility</h2>
              <div class="fact-list">
                <p><strong>Permit age</strong><span>{state.gdl.permitMinAge}</span></p>
                <p><strong>Holding period</strong><span>{state.gdl.permitHoldingPeriod ?? 'Confirm with the agency'}</span></p>
                <p><strong>Supervised practice</strong><span>{state.gdl.supervisedHoursRequired ?? 'Confirm with the agency'}</span></p>
                {state.gdl.driverEdRequired !== undefined && (
                  <p><strong>Driver education</strong><span>{state.gdl.driverEdRequired ? 'Required for the listed path' : 'Not listed as required'}</span></p>
                )}
              </div>
            </article>

            <article class="card article-card">
              <p class="eyebrow">Step 2</p>
              <h2>Gather what you need</h2>
              <ul class="document-list">
                {state.process.requiredDocuments.map((document) => <li><span aria-hidden="true">✓</span>{document}</li>)}
              </ul>
              {state.process.realIdNotes && <p class="muted">{state.process.realIdNotes}</p>}
            </article>

            <article class="card article-card">
              <p class="eyebrow">Step 3</p>
              <h2>Plan your agency visit</h2>
              <div class="fact-list">
                <p><strong>Appointment</strong><span>{state.process.appointmentRequired}</span></p>
                <p><strong>Permit fee</strong><span>{state.process.permitFee ?? 'Check the official fee page'}</span></p>
                <p><strong>Vision</strong><span>{state.process.visionTestRequired ? state.process.visionStandard ?? 'Screening required' : 'Not listed as required'}</span></p>
              </div>
              <div class="actions">
                {state.process.schedulingUrl && <a class="btn btn-primary" href={state.process.schedulingUrl}>Official scheduling</a>}
                {state.process.feesUrl && <a class="btn btn-ghost" href={state.process.feesUrl}>Official fee page</a>}
              </div>
            </article>

            <article class="card article-card">
              <p class="eyebrow">Step 4</p>
              <h2>Prepare for the knowledge test</h2>
              <p>Learn with feedback first. When your answers feel consistent, take a mock exam without hints.</p>
              <div class="actions">
                <a class="btn btn-primary" href={href(`/state/${stateSlug(code)}/practice`)}>Start practice</a>
                <a class="btn btn-ghost" href={href(`/state/${stateSlug(code)}/mock`)}>Take a mock exam</a>
              </div>
            </article>

            <article class="card article-card">
              <p class="eyebrow">If you need another try</p>
              <h2>Retake rules</h2>
              <p>{state.retake?.waitBetweenAttempts ?? 'Check with the agency for the current wait between attempts.'}</p>
              {state.retake?.retakeFee && <p>{state.retake.retakeFee}</p>}
            </article>
          </div>

          <aside class="guide-aside">
            <div class="callout">
              <p class="eyebrow">Official source</p>
              <h2>Finish with the handbook.</h2>
              <p>Rules and fees can change after our verification date. Check the current source before applying.</p>
              <p><a href={state.handbookLandingUrl}>Read the official handbook →</a></p>
              <p><a href={state.officialSiteUrl}>Visit {state.agencyShort} →</a></p>
            </div>
            <div class="card article-card">
              <h3>Before you leave</h3>
              <ul>
                <li>Confirm your appointment</li>
                <li>Recheck original document rules</li>
                <li>Verify current payment methods</li>
                <li>Bring corrective lenses if needed</li>
              </ul>
            </div>
          </aside>
        </section>
      </>
    ) : (
      <article class="card article-card">
        <p class="eyebrow">Verification in progress</p>
        <h2>The detailed {directory.name} guide is coming.</h2>
        <p>
          We only publish application details after checking official sources. Use the
          {' '}{directory.agencyShort} website for current documents, fees, and appointments.
        </p>
      </article>
    )}
  </section>
</BaseLayout>

<style>
  .fact-list {
    display: grid;
  }

  .fact-list p {
    display: grid;
    grid-template-columns: minmax(8rem, 0.6fr) 1fr;
    gap: var(--sp-4);
    padding-block: var(--sp-3);
    border-bottom: var(--border-width) solid var(--c-border);
  }

  .fact-list span {
    color: var(--c-text-muted);
  }

  .document-list {
    padding: 0;
    list-style: none;
  }

  .document-list li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--sp-3);
    padding-block: var(--sp-3);
    border-bottom: var(--border-width) solid var(--c-border);
  }

  .document-list span {
    color: var(--c-pass);
    font-weight: 900;
  }

  .guide-aside {
    position: sticky;
    top: calc(var(--header-height) + var(--sp-4));
    display: grid;
    gap: var(--sp-4);
  }

  @media (max-width: 52rem) {
    .guide-aside {
      position: static;
    }
  }

  @media (max-width: 32rem) {
    .fact-list p {
      grid-template-columns: 1fr;
      gap: var(--sp-1);
    }
  }
</style>
