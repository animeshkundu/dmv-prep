---
import BaseLayout from '../../../layouts/BaseLayout.astro'; import { STATES, byCode, stateSlug } from '../../../lib/states-directory'; import { studyContent } from '../../../lib/content'; import '../../../styles/pages.css';
export function getStaticPaths(){return STATES.map((state)=>({params:{code:stateSlug(state.code)}}));} const code=Astro.params.code!.toUpperCase(); const directory=byCode(code)!; const {state}=await studyContent(code);
---
<BaseLayout title={`${directory.name} permit guide`}><section class="container container-narrow page-shell"><h1>Get your {directory.name} permit</h1><p class="muted">This is an unofficial study aid. Confirm requirements with the licensing agency before applying.</p>{state ? <><p class="badge">Verified {state.lastVerified}</p><article class="card study-card"><h2>Eligibility and graduated licensing</h2><p>Permit age: {state.gdl.permitMinAge}</p><p>Holding period: {state.gdl.permitHoldingPeriod ?? 'Not specified'}</p><p>Supervised practice: {state.gdl.supervisedHoursRequired ?? 'Not specified'}</p></article><article class="card study-card"><h2>What to bring</h2><ul>{state.process.requiredDocuments.map((document)=><li>{document}</li>)}</ul><p>{state.process.realIdNotes}</p></article><article class="card study-card"><h2>Appointment, fees, and vision</h2><p>Appointment: {state.process.appointmentRequired}</p><p>Permit fee: {state.process.permitFee ?? 'Check the official fee page'}</p><p>Vision: {state.process.visionTestRequired ? state.process.visionStandard ?? 'Test required' : 'Not required'}</p>{state.process.schedulingUrl && <p><a href={state.process.schedulingUrl}>Schedule on the official site</a></p>}<p><a href={state.handbookLandingUrl}>Read the official handbook</a></p></article><article class="card study-card"><h2>Retakes</h2><p>{state.retake?.waitBetweenAttempts ?? 'Check with the agency for current retake rules.'}</p><p>{state.retake?.retakeFee}</p></article></> : <article class="card study-card"><h2>Guide coming soon</h2><p>We are verifying this state's official process. Check your local {directory.agencyShort} website for current documents, fees, and appointments.</p></article>}</section></BaseLayout>
