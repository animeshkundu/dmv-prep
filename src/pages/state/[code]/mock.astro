---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import TestRunner from '../../../islands/TestRunner';
import type { TestDefinition } from '../../../islands/TestRunner';
import { STATES, byCode, stateSlug } from '../../../lib/states-directory';
import { studyContent } from '../../../lib/content';
import { applicableQuestions, seedQuestions } from '../../../lib/questions';
import { assetUrl } from '../../../lib/site';
import { getBankBuildData } from '../../../lib/bank-build';
import '../../../styles/pages.css';

export function getStaticPaths() {
  return STATES.map((state) => ({ params: { code: stateSlug(state.code) } }));
}

const code = Astro.params.code!.toUpperCase();
const directory = byCode(code)!;
const content = await studyContent(code);
const questions = applicableQuestions(content.questions, code);
const variants = content.state?.examVariants ?? [
  {
    variantId: 'practice',
    label: 'Practice mock exam',
    numQuestions: Math.min(20, questions.length),
    numToPass: Math.ceil(Math.min(20, questions.length) * 0.8),
    languages: ['en'],
    onlineAvailable: false,
  },
];
// Enough to rehearse offline; the full exam is built from the fetched bank.
const seed = seedQuestions(questions, 10);
const bankUrl = assetUrl(`/bank/${stateSlug(code)}.json`);
const signUrl = assetUrl('/bank/signs.json');
const { bankVersion } = await getBankBuildData();
const definition: TestDefinition = {
  mode: 'mock',
  feedback: 'deferred',
  navigation: 'free',
  timer: true,
};
const description = `Take a free ${directory.name} DMV mock exam with state-aware question counts, passing targets, and a complete results review.`;
---

<BaseLayout title={`${directory.name} DMV Mock Exam`} description={description}>
  <section class="study-shell">
    <Breadcrumbs
      items={[
        { label: 'Home', path: '/' },
        { label: 'States', path: '/states' },
        { label: directory.name, path: `/state/${stateSlug(code)}` },
        { label: 'Mock exam' },
      ]}
    />
    <header class="study-intro">
      <p class="eyebrow">Test-day rehearsal</p>
      <h1>{directory.name} DMV mock exam</h1>
      <p class="lede">
        No hints and no answer reveals until you finish. Choose your exam version, meet the real
        score target, then review every miss.
      </p>
    </header>
    <TestRunner
      client:load
      state={code}
      definition={definition}
      seedQuestions={seed}
      bankUrl={bankUrl}
      bankVersion={bankVersion}
      signUrl={signUrl}
      variants={variants}
    />
  </section>
</BaseLayout>
