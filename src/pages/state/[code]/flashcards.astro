---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import Flashcards from '../../../islands/Flashcards';
import { STATES, byCode, stateSlug } from '../../../lib/states-directory';
import { studyContent } from '../../../lib/content';
import { applicableQuestions, seedQuestions } from '../../../lib/questions';
import { toClientSigns } from '../../../lib/bank';
import { getBankBuildData } from '../../../lib/bank-build';
import { assetUrl } from '../../../lib/site';
import '../../../styles/pages.css';

export function getStaticPaths() {
  return STATES.map((state) => ({ params: { code: stateSlug(state.code) } }));
}

const code = Astro.params.code!.toUpperCase();
const directory = byCode(code)!;
const content = await studyContent(code);
const questions = applicableQuestions(content.questions, code);
const seed = seedQuestions(questions, 10);
const { bankVersion } = await getBankBuildData();
---

<BaseLayout
  title={`${directory.name} DMV Flashcards`}
  description={`Study ${directory.name} permit rules and US road signs with free smart flashcards that schedule review when you need it.`}
>
  <section class="study-shell">
    <Breadcrumbs
      items={[
        { label: 'Home', path: '/' },
        { label: 'States', path: '/states' },
        { label: directory.name, path: `/state/${stateSlug(code)}` },
        { label: 'Flashcards' },
      ]}
    />
    <header class="study-intro">
      <p class="eyebrow">Remember more with less repetition</p>
      <h1>{directory.name} permit flashcards</h1>
      <p class="lede">
        Reveal the answer, rate how it felt, and let smart spacing choose when the card returns.
        Your schedule stays private on this device.
      </p>
      <div class="actions">
        <span class="badge">{questions.length + content.signs.length} cards</span>
        <span class="badge">Smart spaced review</span>
      </div>
    </header>
    <Flashcards
      client:load
      seedQuestions={seed}
      stateCode={code}
      bankUrl={assetUrl(`/bank/${stateSlug(code)}.json`)}
      bankVersion={bankVersion}
      signs={toClientSigns(content.signs)}
      signUrl={assetUrl('/bank/signs.json')}
    />
  </section>
</BaseLayout>
