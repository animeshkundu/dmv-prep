---
import { href } from '../lib/site';
---

<footer class="site-footer">
  <div class="container footer-inner">
    <p class="disclaimer">
      <strong>Unofficial study aid.</strong> DMV Prep is not affiliated with any state agency. Always
      verify requirements against your state's official driver handbook. Questions are original and
      grounded in public handbooks.
    </p>
    <nav class="footer-links" aria-label="Footer">
      <a href={href('/states')}>All states</a>
      <a href={href('/guide')}>Permit guide</a>
      <a href={href('/about')}>About</a>
      <a href={href('/privacy')}>Privacy</a>
      <a href="https://github.com/animeshkundu/dmv-prep" rel="noopener">Source &amp; corrections</a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--c-border);
    margin-top: var(--sp-10);
    background: var(--c-surface);
  }
  .footer-inner {
    display: grid;
    gap: var(--sp-4);
    padding-block: var(--sp-6);
  }
  .disclaimer {
    color: var(--c-text-muted);
    font-size: var(--fs-sm);
    max-width: var(--container-narrow);
  }
  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-4);
    font-size: var(--fs-sm);
  }
  .footer-links a {
    color: var(--c-text-muted);
    text-decoration: none;
  }
  .footer-links a:hover {
    color: var(--c-accent);
  }
</style>
